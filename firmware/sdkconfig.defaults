# Project defaults. `sdkconfig` is generated from this file and is not committed;
# change settings here (or via `idf.py menuconfig` + `idf.py save-defconfig`).

# Hardware: ESP32-WROOM-32 module, 4 MB flash, no PSRAM
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y

# Performance: audio DSP runs per sample
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_FREERTOS_HZ=1000

# Robustness
CONFIG_COMPILER_STACK_CHECK_MODE_STRONG=y
CONFIG_FREERTOS_CHECK_STACKOVERFLOW_CANARY=y
CONFIG_ESP_TASK_WDT_EN=y
CONFIG_ESP_TASK_WDT_INIT=y
CONFIG_ESP_TASK_WDT_PANIC=y
CONFIG_ESP_TASK_WDT_TIMEOUT_S=5
CONFIG_ESP_SYSTEM_PANIC_PRINT_REBOOT=y
CONFIG_ESP_BROWNOUT_DET=y
CONFIG_COMPILER_WARN_WRITE_STRINGS=y

# Logging: keep the boot ROM/bootloader quiet, application at INFO
CONFIG_BOOTLOADER_LOG_LEVEL_WARN=y
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
